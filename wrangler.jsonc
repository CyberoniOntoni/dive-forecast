{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deploy (OpenNext). Build with `npm run cf:build`; see CLOUDFLARE.md.
  "name": "dive-forecast",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      // The Open-Meteo cache (marine-cache/...), map nowcasts and divers' site photos (site-photos/...). Also the old store.json, copied into D1 once and kept
      // as a backup. lib/cloudflare.ts.
      "binding": "DATA",
      "bucket_name": "dive-current-data"
    }
  ],
  "d1_databases": [
    {
      // Reports, ratings, added pins, accounts and sign-in codes (lib/store-d1.ts). Tables are created by the app.
      "binding": "DB",
      "database_name": "dive-forecast",
      "database_id": "354f2a29-933a-4613-9146-58e02859c51b"
    }
  ],
  "send_email": [
    {
      // Cloudflare Email Sending for the sign-in email (lib/email.ts); Mailgun is the fallback. 50bar.app must be
      // onboarded in Email Service → Email Sending, or every send falls through to Mailgun.
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@50bar.app"]
    }
  ],
  // Kept here, not in the dashboard: a deploy replaces dashboard routes and vars with this file's.
  "routes": [{ "pattern": "50bar.app", "custom_domain": true }],
  // Sign-in settings that are not secret (CLOUDFLARE.md § Sign-in). AUTH_SECRET and MAILGUN_API_KEY are Worker
  // secrets, set in the dashboard; deploys keep those.
  "vars": {
    "APP_URL": "https://50bar.app",
    "EMAIL_FROM": "login@50bar.app",
    "MAILGUN_DOMAIN": "mailgun.50bar.app"
  },
  // The cache warm-up (cloudflare-worker.js scheduled, lib/warm.ts), hourly at :50: refreshes Open-Meteo series before
  // they pass the 6-hour TTL and builds the next hour's map nowcasts, so a visitor after a quiet spell does not wait for them.
  // Not in "previews": preview builds run no cron.
  "triggers": { "crons": ["50 * * * *"] },
  "limits": {
    // Workers Paid allows up to 5 minutes; the map's first nowcast of every site is the heaviest request.
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true
  },
  // PR branch builds run `wrangler preview` (Workers Builds' non-production deploy command), which uses only this block
  // for bindings and settings. Previews get their own empty database and bucket so test reports, sign-ins and cache
  // writes never reach the live site. No APP_URL (a preview has no fixed address) and no AUTH_SECRET, so signing in
  // says it is not set up there; reading works.
  "previews": {
    "r2_buckets": [{ "binding": "DATA", "bucket_name": "dive-current-data-preview" }],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "dive-forecast-preview",
        "database_id": "edae9e32-8eec-4ae0-9307-f666f2b9718f"
      }
    ],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["login@50bar.app"] }],
    "vars": {
      "EMAIL_FROM": "login@50bar.app",
      "MAILGUN_DOMAIN": "mailgun.50bar.app"
    },
    "limits": { "cpu_ms": 30000 },
    "observability": { "enabled": true }
  }
}
