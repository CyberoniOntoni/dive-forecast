    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "pbf": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "node-domexception": "npm:@nolyfill/domexception@^1.0.28",
    "@node-minify/core": {
      "glob": "^13.0.6"
    },
    "eslint": "$eslint"
  }
