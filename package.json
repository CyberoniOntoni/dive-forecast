  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
