<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in token (shared prefs file "session") never leaves the phone: a restored copy would sign in elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
